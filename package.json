{
  "name": "cronet-request",
  "version": "0.1.1",
  "description": "Requests-compatible HTTP client backed by bundled Cronet shared libraries",
  "main": "index.js",
  "types": "index.d.ts",
  "author": "qq185863818",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq185863818/cronet-request.git"
  },
